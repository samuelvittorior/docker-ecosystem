# =============================================================================
# Environment aplikasi (AttendApp) - dibaca container `app` lewat `env_file`.
# Ini BUKAN file .env milik Laravel: nilainya masuk sebagai environment
# variable container sehingga TIDAK bisa ditimpa oleh .env di folder aplikasi.
# =============================================================================

# Path kode aplikasi (repo `attendapp`). Default: folder SIBLING dari
# `docker-ecosystem` (lihat README "Struktur Direktori"):
#   ~/projects/docker-ecosystem/app-laravel-docker/  ->  ../../attendapp
#   ~/projects/attendapp/
# Bila struktur folder Anda berbeda, timpa lewat file `app-laravel-docker/.env`:
#   LARAVEL_APP_PATH=../attendapp
LARAVEL_APP_PATH=../../attendapp

APP_NAME=AttendApp
APP_ENV=production
APP_DEBUG=false
# Sesuaikan dengan domain/subdomain yang dipakai (atau biarkan IP).
APP_URL=http://app.attendapp.local

# Kunci enkripsi Laravel (cookie & session). HARUS valid base64 32 byte,
# kalau tidak Laravel melempar "The only supported ciphers are AES-128-CBC
# and AES-256-CBC with the correct key lengths".
# Buat baru: php artisan key:generate --show   (jangan pernah di-share)
APP_KEY=base64:cz4dUA+SnQ4yo4psJKA0l76dYf/8SdwTXIqm1qCHGgE=

# Biarkan false selama aplikasi masih diakses lewat http://IP_VPS.
# Set true setelah HTTPS aktif, agar aset & redirect memakai https://.
APP_FORCE_HTTPS=false

LOG_CHANNEL=stack
# `single,stderr`: error juga tampil di `docker compose logs app`.
# Penyebab 500 jadi langsung terlihat tanpa perlu membuka file log.
LOG_STACK=single,stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# -----------------------------------------------------------------------------
# Database - PostgreSQL (compose terpisah, koneksi lewat shared-network)
# DB_USERNAME/DB_PASSWORD harus sama dengan role yang dibuat
# db-postgres-docker/postgres/conf.d/10-attendapp-database.sql
# -----------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=postgres-db
DB_PORT=5432
DB_DATABASE=attendapp
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_SCHEMA=public
DB_SSLMODE=prefer

# -----------------------------------------------------------------------------
# Redis BERSAMA (compose terpisah: redis-shared-docker/)
#
#   REDIS_HOST=redis-shared   -> alias DNS di shared-network
#   REDIS_PASSWORD            -> HARUS sama dengan redis-shared-docker/.env.docker
#
# ALOKASI NOMOR DB (wajib unik antar aplikasi, lihat tabel di
# redis-shared-docker/README.md):
#   REDIS_DB=0       -> session, queue, lock
#   REDIS_CACHE_DB=1 -> cache aplikasi + cache laporan rekap
# Aplikasi berikutnya memakai 2/3, lalu 4/5, dst.
# -----------------------------------------------------------------------------
BROADCAST_DRIVER=log
CACHE_DRIVER=redis
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=redis
SESSION_LIFETIME=120

REDIS_CLIENT=phpredis
REDIS_HOST=redis-shared
REDIS_PASSWORD=SI_SECRET_PASSWORD_RDS1
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
# Prefix key unik per aplikasi (pengaman tambahan selain pemisahan nomor DB).
REDIS_PREFIX=attendapp_
# Gagal cepat bila Redis tidak terjangkau, jangan sampai request menggantung.
REDIS_TIMEOUT=2
REDIS_READ_TIMEOUT=5

# Cache hasil perhitungan Rekap Absensi & Rekap Lembur.
# TTL dalam detik; false untuk mematikan (debug hasil rekap).
RECAP_CACHE_ENABLED=true
RECAP_CACHE_TTL=600

# Token API payroll eksternal (opsional, lihat docs/payroll-api.md)
PAYROLL_API_TOKEN=

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

# User pemilik folder storage & bootstrap/cache di dalam container.
# Biarkan www-data (sesuai php/www.conf). Entrypoint akan chown ke user ini.
FPM_USER=www-data
FPM_GROUP=www-data

# Flags entrypoint (opsional, default false)
# true : jalankan "php artisan migrate --force" setiap container start
RUN_MIGRATIONS=true
# true : jalankan config:cache, route:cache, view:cache
RUN_OPTIMIZE=true
