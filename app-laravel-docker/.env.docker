APP_NAME=Laravel
APP_ENV=production
APP_DEBUG=false
APP_URL=http://app.laravel-test.com

# Kunci enkripsi Laravel (cookie/session). WAJIB ada.
# Ganti dengan hasil `php artisan key:generate --show` milik Anda dan JAGA RAHASIA.
APP_KEY=base64:ytfXM7ECv6Jkw3oUhCE981rpSKQWzZAJXM00tM62GhI=

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Database (PostgreSQL ada di compose terpisah, koneksi lewat shared-network)
DB_CONNECTION=pgsql
DB_HOST=postgres-db
DB_PORT=5432
DB_DATABASE=laravel-test
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Redis (ada di docker-compose ini, service name: redis)
BROADCAST_DRIVER=log
CACHE_DRIVER=redis
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=redis
SESSION_LIFETIME=120

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

# User pemilik folder storage & bootstrap/cache di dalam container.
# Biarkan www-data (sesuai php/www.conf). Entrypoint akan chown ke user ini.
FPM_USER=www-data
FPM_GROUP=www-data

# Flags entrypoint (opsional, default false)
# true : jalankan "php artisan migrate --force" setiap container start
RUN_MIGRATIONS=true
# true : jalankan config:cache, route:cache, view:cache
RUN_OPTIMIZE=true