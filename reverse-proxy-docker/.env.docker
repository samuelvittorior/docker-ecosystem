# Reverse Proxy Configuration
PROXY_PORT=80
PROXY_SSL_PORT=443

# Akses langsung tanpa domain: http://<IP_VPS>:8101 -> AttendApp
# Port host ini dipetakan ke port 8080 container reverse proxy.
APP_HTTP_PORT=8101

# Aplikasi kedua & ketiga (blok `listen 8081` / `listen 8082` di nginx/default.conf).
ITHELPER_HTTP_PORT=8102
IMON_HTTP_PORT=8103

# Domain settings
APP_SUBDOMAIN=app
DOMAIN=attendapp.com

# Network
SHARED_NETWORK=shared-network