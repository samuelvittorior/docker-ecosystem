# Reverse Proxy Configuration
PROXY_PORT=80
PROXY_SSL_PORT=443

# Akses langsung tanpa domain: http://<IP_VPS>:8101 -> AttendApp
# Port host ini dipetakan ke port 8080 container reverse proxy.
APP_HTTP_PORT=8101

# Domain settings
APP_SUBDOMAIN=app
DOMAIN=attendapp.com

# Network
SHARED_NETWORK=shared-network