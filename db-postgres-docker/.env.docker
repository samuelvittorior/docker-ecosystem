# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=attendapp

# Shared Buffer & Memory Configuration (untuk VPS 6GB RAM)
# shared_buffers = 25% dari RAM total = ~1.5GB untuk 6GB
POSTGRES_SHARED_BUFFERS=1536MB
# work_mem = memori per operasi sort/hash
POSTGRES_WORK_MEM=64MB
# maintenance_work_mem = untuk VACUUM, CREATE INDEX
POSTGRES_MAINTENANCE_WORK_MEM=256MB
# effective_cache_size = estimasi memori yang tersedia untuk caching
POSTGRES_EFFECTIVE_CACHE_SIZE=4608MB
# wal_buffers
POSTGRES_WAL_BUFFERS=16MB
# max_connections
POSTGRES_MAX_CONNECTIONS=100