# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=attendapp

# =============================================================================
# Profil tuning PostgreSQL. File konfigurasinya:
#   postgres/conf.d/shared-buffer.sql
#
# Pilih SESUAI RAM VPS (cek dengan: free -h):
#   small   -> VPS 1-2 GB RAM   (shared_buffers 256MB,  work_mem 8MB,  max_conn 30)
#   medium  -> VPS 4 GB RAM     (shared_buffers 1024MB, work_mem 16MB, max_conn 50)
#   large   -> VPS 6-8 GB RAM   (shared_buffers 1536MB, work_mem 32MB, max_conn 100)
#   custom  -> pakai nilai POSTGRES_TUNING_* di bawah
#
# Salah setel ke arah terlalu besar -> PostgreSQL + PHP-FPM + Redis berebut
# memori, VPS swap, dan SEMUA request jadi lambat. Karena itu profil ini
# eksplisit: satu baris, mudah disesuaikan.
#
# Mengubah profil SETELAH volume postgres-data terisi:
#   docker compose down && docker compose up -d      (initdb tidak jalan lagi!)
#   -> lalu terapkan manual lewat psql (lihat komentar di shared-buffer.sql),
#      karena docker-entrypoint-initdb.d hanya dieksekusi saat inisialisasi awal.
# =============================================================================
POSTGRES_TUNING=large

# Dipakai HANYA bila POSTGRES_TUNING=custom.
POSTGRES_TUNING_SHARED_BUFFERS=1536MB
POSTGRES_TUNING_WORK_MEM=32MB
POSTGRES_TUNING_MAINTENANCE_WORK_MEM=256MB
POSTGRES_TUNING_EFFECTIVE_CACHE_SIZE=4608MB
POSTGRES_TUNING_MAX_CONNECTIONS=100