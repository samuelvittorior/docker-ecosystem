# =============================================================================
# Redis BERSAMA - dipakai beberapa aplikasi lewat `shared-network`
# =============================================================================

# Password Redis. Dipakai juga oleh aplikasi (REDIS_PASSWORD di
# app-laravel-docker/.env.docker). Ganti sebelum online dan samakan di keduanya.
REDIS_PASSWORD=SI_SECRET_PASSWORD_RDS1

# Batas memori. Nilai ini berlaku GLOBAL untuk semua aplikasi yang memakai
# Redis ini (Redis tidak bisa membatasi memori per aplikasi).
# Saran: ~5-10% RAM VPS (VPS 6 GB -> 384 MB).
REDIS_MAXMEMORY=384mb
