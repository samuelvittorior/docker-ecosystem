# =============================================================================
# Environment aplikasi ItemMonitoring - dibaca container `imon-app` lewat env_file.
# Ini BUKAN file .env milik Laravel: nilainya masuk sebagai environment variable
# container sehingga TIDAK bisa ditimpa oleh .env di folder aplikasi.
#
# File ini DI-COMMIT dan dibaca auto-deploy (git pull --ff-only). Jangan edit
# manual di VPS -- `git pull` berikutnya akan gagal karena working tree kotor.
# =============================================================================

# Path kode aplikasi (repo ItemMonitoring) relatif terhadap folder ini.
# Default: folder SIBLING dari docker-ecosystem:
#   ~/projects/docker-ecosystem/imon-docker/  ->  ../../ItemMonitoring
#
# CATATAN COMPOSE: baris ini hanya dokumentasi. Interpolasi `${LARAVEL_APP_PATH}`
# di docker-compose.yml TIDAK membaca env_file ini (env_file hanya mengisi
# environment CONTAINER). Untuk menimpa path, buat file `.env` di folder ini:
#   echo 'LARAVEL_APP_PATH=../ItemMonitoring' > .env
LARAVEL_APP_PATH=../../ItemMonitoring

APP_NAME=ItemMonitoring
APP_ENV=production
APP_DEBUG=false
# Domain publik aplikasi ini (HTTPS diaktifkan dengan tools/enable-https.sh,
# lihat README bagian "Mengaktifkan HTTPS untuk ItemMonitoring").
APP_URL=https://imon.kovcc.web.id

# Kunci enkripsi Laravel (cookie & session).
#
# SENGAJA TIDAK DIISI DI SINI. Variabel environment container MENANG atas isi
# file .env (Laravel memakai dotenv "immutable"). Kalau baris APP_KEY ada di
# sini tetapi kosong, kunci kosong itulah yang menang -- baik untuk PHP-FPM
# maupun `php artisan` lewat `docker exec` -- sehingga semua request 500 dengan
# "The only supported ciphers are AES-128-CBC and AES-256-CBC...".
#
# Tanpa baris ini, entrypoint memakai APP_KEY valid dari ItemMonitoring/.env,
# atau membuat yang baru lalu MENYIMPANNYA ke .env (stabil antar restart).
# Ingin mengunci nilainya? Isi dengan nilai valid ("base64:" + 32 byte atau
# 32 karakter mentah) dari: php artisan key:generate --show
# APP_KEY=

LOG_CHANNEL=stack
# `single,stderr`: error juga tampil di `docker compose logs imon-app`.
LOG_STACK=single,stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# -----------------------------------------------------------------------------
# Database - PostgreSQL BERSAMA (db-postgres-docker), lewat shared-network.
#
#   DB_HOST=postgres-db          -> nama container PostgreSQL di shared-network
#   DB_DATABASE=item_monitoring  -> database KHUSUS aplikasi ini
#   DB_USERNAME=imon             -> role khusus (BUKAN superuser postgres)
#   DB_PASSWORD                  -> HARUS sama dengan CREATE ROLE di
#                                   db-postgres-docker/postgres/conf.d/20-app-databases.sql
#
# Catatan: aplikasi ini BELUM memakai database untuk fiturnya, tetapi koneksi
# sudah disiapkan supaya siap dipakai tanpa mengubah infra.
# -----------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=postgres-db
DB_PORT=5432
DB_DATABASE=item_monitoring
DB_USERNAME=imon
DB_PASSWORD=SI_SECRET_PASSWORD_Q4W7EMRB
DB_SCHEMA=public
DB_SSLMODE=prefer

# -----------------------------------------------------------------------------
# TIDAK memakai Redis (Redis hanya untuk AttendApp).
# -----------------------------------------------------------------------------
BROADCAST_DRIVER=log
CACHE_DRIVER=file
# Laravel 10 memakai FILESYSTEM_DISK; FILESYSTEM_DRIVER dipertahankan agar
# kompatibel bila kode masih membaca nama lama.
FILESYSTEM_DISK=local
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MAIL_MAILER=log
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="imon@kovcc.web.id"
MAIL_FROM_NAME="${APP_NAME}"

# User pemilik folder storage & bootstrap/cache di dalam container.
FPM_USER=www-data
FPM_GROUP=www-data

# Flags entrypoint
RUN_MIGRATIONS=true
RUN_OPTIMIZE=true
