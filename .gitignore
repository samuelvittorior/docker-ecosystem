# =============================================================================
# .gitignore untuk docker-ecosystem
# Tujuan: HANYA menyimpan file konfigurasi Docker/Infra.
# Kode aplikasi Laravel (folder attendapp/) dikelola di repo terpisah,
# jadi di-exclude dari repo ini.
# =============================================================================

# Kode aplikasi Laravel -> dikelola di repo sendiri
# (masing-masing aplikasi punya repo & pipeline sendiri)
attendapp/
ITHelper/
ItemMonitoring/

# Environment & secret (jangan pernah di-commit)
**/.env
**/.env.docker.swp
*.env
!**/.env.docker

# Kunci/cert SSL
reverse-proxy-docker/nginx/certs/*
!reverse-proxy-docker/nginx/certs/.gitkeep

# Webroot Let's Encrypt: hanya file challenge sementara, jangan di-commit
reverse-proxy-docker/nginx/certbot/*
!reverse-proxy-docker/nginx/certbot/.gitkeep

# Hasil tools/enable-https.sh (berisi nama domain Anda, bukan rahasia, tapi
# spesifik per server). Template-nya tetap di-commit: *.conf.example
reverse-proxy-docker/nginx/extra/*.conf

# Log & data runtime
app-laravel-docker/storage/logs/*
!app-laravel-docker/storage/logs/.gitkeep

# Override compose (berisi setting lokal)
docker-compose.override.yml
**/docker-compose.override.yml

# Editor / OS
.idea/
.vscode/
*.swp
Thumbs.db
.DS_Store
