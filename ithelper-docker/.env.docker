# =============================================================================
# Environment aplikasi ITHelper - dibaca container `ithelper-app` lewat env_file.
# Ini BUKAN file .env milik Laravel: nilainya masuk sebagai environment variable
# container sehingga TIDAK bisa ditimpa oleh .env di folder aplikasi.
#
# File ini DI-COMMIT dan dibaca auto-deploy (git pull --ff-only). Kalau diedit
# manual di VPS, `git pull` berikutnya gagal karena working tree kotor ->
# ubah di repo, bukan di server.
# =============================================================================

# Path kode aplikasi (repo ITHelper) relatif terhadap folder ini.
# Default: folder SIBLING dari docker-ecosystem (lihat README "Struktur"):
#   ~/projects/docker-ecosystem/ithelper-docker/  ->  ../../ITHelper
#
# CATATAN COMPOSE: baris ini hanya dokumentasi. Interpolasi `${LARAVEL_APP_PATH}`
# di docker-compose.yml TIDAK membaca env_file ini (env_file hanya mengisi
# environment CONTAINER). Untuk menimpa path, buat file `.env` di folder ini:
#   echo 'LARAVEL_APP_PATH=../ITHelper' > .env
LARAVEL_APP_PATH=../../ITHelper

APP_NAME=ITHelper
APP_ENV=production
APP_DEBUG=false
# Domain publik aplikasi ini (HTTPS diaktifkan dengan tools/enable-https.sh,
# lihat README bagian "Mengaktifkan HTTPS untuk ITHelper").
APP_URL=https://desk.kovcc.web.id

# Kunci enkripsi Laravel (cookie & session).
#
# SENGAJA TIDAK DIISI DI SINI. Alasannya teknis dan penting:
#   Variabel environment container MENANG atas isi file .env (Laravel memakai
#   dotenv "immutable"). Kalau baris APP_KEY ada di file ini tetapi nilainya
#   kosong, maka kunci kosong itulah yang menang -- baik untuk PHP-FPM maupun
#   untuk `php artisan` lewat `docker exec`, sehingga SEMUA request 500 dengan
#   "The only supported ciphers are AES-128-CBC and AES-256-CBC...".
#
# Tanpa baris APP_KEY di sini, entrypoint akan:
#   1. memakai APP_KEY dari ITHelper/.env bila valid, atau
#   2. membuat kunci acak valid (32 byte) lalu MENYIMPANNYA ke ITHelper/.env,
# sehingga nilainya tetap sama antar restart (session tidak hangus) dan
# konsisten untuk FPM maupun CLI.
#
# Ingin mengunci nilainya di infra (opsional)? Isi dengan nilai VALID
# ("base64:" + 32 byte, atau 32 karakter mentah), mis. hasil:
#   docker compose exec ithelper-app php artisan key:generate --show
# APP_KEY=


LOG_CHANNEL=stack
# `single,stderr`: error juga tampil di `docker compose logs ithelper-app`,
# sehingga penyebab 500 langsung terlihat tanpa membuka file log.
LOG_STACK=single,stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# -----------------------------------------------------------------------------
# Database - PostgreSQL BERSAMA (db-postgres-docker), lewat shared-network.
#
#   DB_HOST=postgres-db   -> nama container PostgreSQL di shared-network
#   DB_DATABASE=ithelper  -> database KHUSUS aplikasi ini (bukan database
#                            AttendApp), dibuat oleh
#                            db-postgres-docker/postgres/conf.d/20-app-databases.sql
#   DB_USERNAME=ithelper  -> role khusus, BUKAN superuser postgres
#   DB_PASSWORD           -> HARUS sama dengan CREATE ROLE di file SQL tersebut
# -----------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=postgres-db
DB_PORT=5432
DB_DATABASE=ithelper
DB_USERNAME=ithelper
DB_PASSWORD=SI_SECRET_PASSWORD_P5ANHNCX
DB_SCHEMA=public
DB_SSLMODE=prefer

# -----------------------------------------------------------------------------
# TIDAK memakai Redis (keputusan desain: Redis hanya untuk AttendApp).
# Cache & session disimpan di file (storage/framework/...), yang sudah
# di-bind-mount dari host sehingga tetap ada setelah container recreate.
# -----------------------------------------------------------------------------
BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Mail: isi kredensial SMTP yang sebenarnya sebelum fitur notifikasi dipakai.
# Jangan simpan password asli di repo; pakai App Password Gmail (bukan password
# akun) bila memakai Gmail.
MAIL_MAILER=log
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="ithelper@kovcc.web.id"
MAIL_FROM_NAME="${APP_NAME}"

# User pemilik folder storage & bootstrap/cache di dalam container.
FPM_USER=www-data
FPM_GROUP=www-data

# Flags entrypoint
# true : jalankan "php artisan migrate --force" setiap container start
RUN_MIGRATIONS=true
# true : jalankan config:cache, route:cache, view:cache
RUN_OPTIMIZE=true
